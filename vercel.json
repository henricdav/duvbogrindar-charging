{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "installCommand": "cd server && npm install",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "client/dist"
      }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["server/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/client/dist/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/update-data",
      "schedule": "0 2 * * *"
    }
  ]
}
