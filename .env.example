# Easee API Credentials
EASEE_USERNAME=your-easee-username
EASEE_PASSWORD=your-easee-password

# Database Configuration (for manual/Docker setup)
# Format: postgresql://username:password@localhost:5432/duvbogrindar_charging
# For Vercel: This will be auto-set if using Vercel Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/duvbogrindar_charging

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend API URL (for Vercel deployment, set to /api)
# VITE_API_URL=http://localhost:3001/api
