# Easee API Credentials
EASEE_USERNAME=your-easee-username
EASEE_PASSWORD=your-easee-password

# Database Configuration
# For local development: postgresql://postgres:postgres@localhost:5432/duvbogrindar_charging
# For Vercel/Neon: Use your Neon connection string (SSL enabled automatically in production)
# Example Neon: postgresql://user:password@ep-example-123456.region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/duvbogrindar_charging

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend API URL
# For local development with separate frontend/backend: http://localhost:3001/api
# For Vercel deployment: /api (same domain, uses rewrites)
VITE_API_URL=/api
